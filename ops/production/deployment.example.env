# Copy to a local, untracked deployment environment file before releasing.
# Do not place passwords, OpenAI keys or session secrets in this file.
DEPLOY_HOST=example.org
DEPLOY_USER=root
DEPLOY_SSH_KEY=/absolute/path/to/id_rsa
DEPLOY_WEB_ROOT=/var/www/ozelif-8091
DEPLOY_APP_ROOT=/opt/ozelif-admin
DEPLOY_API_PORT=8093
DEPLOY_PUBLIC_PORT=8091
# Absolute path to the current frontend release. The API reads only index.html
# from this directory to render dynamic SEO metadata for product detail URLs.
OZELIF_FRONTEND_ROOT=/var/www/ozelif-8091
